{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": ["**/*.js", "!node_modules", "!.cache", "!**/.cache", "!**/node_modules", "!docs/**", "!public/**", "!**/*.min.js", "!products/presentation/assets/**"]
  },
  "formatter": { "enabled": false },
  "assist": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": false,
      "correctness": {
        "noUndeclaredVariables": "error",
        "noUnreachable": "error",
        "noConstAssign": "error",
        "noInvalidUseBeforeDeclaration": "error",
        "noUnusedVariables": "warn",
        "noUnusedImports": "warn",
        "noSelfAssign": "error",
        "noInnerDeclarations": "off"
      },
      "suspicious": {
        "noDuplicateObjectKeys": "error",
        "noDuplicateCase": "error",
        "noRedeclare": "error",
        "noDoubleEquals": "off",
        "noSelfCompare": "error",
        "noDebugger": "error",
        "noFallthroughSwitchClause": "warn",
        "noAsyncPromiseExecutor": "error",
        "noCompareNegZero": "error"
      }
    }
  },
  "javascript": { "globals": ["document", "window", "Image", "getComputedStyle", "requestAnimationFrame", "OffscreenCanvas", "fetch", "Blob", "FileReader", "atob", "btoa", "Telegram", "location", "navigator", "localStorage", "performance", "HTMLElement", "DOMParser", "XMLSerializer", "URL", "AbortController"] }
}
